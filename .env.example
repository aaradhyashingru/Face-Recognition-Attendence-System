# =========================================================================
# Enterprise Face Recognition Attendance System (FRAS) Environment Config
# =========================================================================

# Application Environment: 'development' or 'production'
ENVIRONMENT=development

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Security: Generate with `python3 -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_64_CHARS_MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Initial Administrator Credentials (seeded only on first run if no admin exists)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=ChangeThisPasswordPromptly!
DEFAULT_ADMIN_EMAIL=admin@fras.local

# Database Connection URL
# SQLite (default for development):
DATABASE_URL=sqlite:///data/attendance.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://fras_user:fras_password@localhost:5432/fras_db

# Allowed CORS Origins (comma-separated, e.g. https://fras.yourdomain.com,http://localhost:8000)
# Leave as '*' only in local development
CORS_ORIGINS=*

# Optional Kiosk API Key (if set, Kiosk frames must include this key in X-Kiosk-Key header)
KIOSK_API_KEY=

# Biometric & Business Logic Thresholds
FACE_DETECTION_CONFIDENCE=0.70
FACE_SIMILARITY_THRESHOLD=0.65
LIVENESS_LAPLACIAN_THRESHOLD=30.0
PUNCH_COOLDOWN_SECONDS=600

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
